# Copy values into root .env; use real HTTPS hostnames before building Android APK.
MONGO_URL=mongodb://127.0.0.1:27017/student_planner?replicaSet=rs0
JWT_SECRET=replace-with-strong-random-value
PEER_SECRET=replace-with-different-strong-random-value
API_INTERNAL_URL=http://127.0.0.1:4000
SIGNAL_INTERNAL_URL=http://127.0.0.1:4001
EXPO_PUBLIC_API_URL=https://api.example.org
EXPO_PUBLIC_SIGNAL_URL=https://signal.example.org
EXPO_PUBLIC_RELAY_URL=https://relay.example.org
VITE_SIGNAL_URL=https://signal.example.org
VITE_RELAY_URL=https://relay.example.org
