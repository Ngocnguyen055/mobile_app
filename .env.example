# Use your Atlas URI, or the local replica set from deploy/compose.yaml.
MONGO_URL=mongodb://127.0.0.1:27017/student_planner?replicaSet=rs0
JWT_SECRET=replace-with-long-random-secret
PEER_SECRET=replace-with-another-long-random-secret
API_PORT=4000
SIGNAL_PORT=4001
RELAY_PORT=4002
# Server-to-server only. Never use EXPO_PUBLIC_ / VITE_ for internal secrets.
API_INTERNAL_URL=http://127.0.0.1:4000
SIGNAL_INTERNAL_URL=http://127.0.0.1:4001
PUBLIC_API_URL=http://localhost:4000
PUBLIC_SIGNAL_URL=http://localhost:4001
PUBLIC_RELAY_URL=http://localhost:4002
# Android Studio Emulator reaches the host machine through 10.0.2.2.
# For a physical phone, replace 10.0.2.2 with the computer's LAN IP.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
EXPO_PUBLIC_SIGNAL_URL=http://10.0.2.2:4001
EXPO_PUBLIC_RELAY_URL=http://10.0.2.2:4002
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
VITE_SIGNAL_URL=http://localhost:4001
VITE_RELAY_URL=http://localhost:4002
