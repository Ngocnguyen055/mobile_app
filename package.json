{
  "name": "student-planner",
  "private": true,
  "type": "module",
  "workspaces": [
    "src/api",
    "src/mobile"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @student-planner/api",
    "dev:mobile": "npm run start -w @student-planner/mobile",
    "typecheck": "tsc --noEmit -p src/api && tsc --noEmit -p src/mobile && tsc --noEmit -p scripts",
    "test": "vitest run",
    "test:calendar-api": "tsx scripts/verify-calendar.ts",
    "test:contacts-api": "tsx scripts/verify-contacts.ts",
    "test:hierarchy-api": "tsx scripts/verify-hierarchy.ts",
    "lint": "eslint src tests scripts --ext .ts,.tsx",
    "seed": "tsx scripts/seed.ts",
    "migrate:projects": "tsx scripts/migrate-projects.ts",
    "android": "npm run android -w @student-planner/mobile",
    "ios": "npm run ios -w @student-planner/mobile"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "eslint": "^9.30.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
